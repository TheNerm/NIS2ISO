    <!-- http://www.hcw.ac.at/nis2iso#CompliantISOEntity -->

    <owl:Class rdf:about="http://www.hcw.ac.at/nis2iso#CompliantISOEntity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
                        <owl:someValuesFrom rdf:resource="http://www.hcw.ac.at/nis2iso#ISORequirementClause10"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
                        <owl:someValuesFrom rdf:resource="http://www.hcw.ac.at/nis2iso#ISORequirementClause4"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
                        <owl:someValuesFrom rdf:resource="http://www.hcw.ac.at/nis2iso#ISORequirementClause5"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
                        <owl:someValuesFrom rdf:resource="http://www.hcw.ac.at/nis2iso#ISORequirementClause6"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
                        <owl:someValuesFrom rdf:resource="http://www.hcw.ac.at/nis2iso#ISORequirementClause7"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
                        <owl:someValuesFrom rdf:resource="http://www.hcw.ac.at/nis2iso#ISORequirementClause8"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
                        <owl:someValuesFrom rdf:resource="http://www.hcw.ac.at/nis2iso#ISORequirementClause9"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.hcw.ac.at/nis2iso#ISOEntity"/>
    </owl:Class>
    



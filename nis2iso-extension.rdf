    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.hcw.ac.at/nis2iso#adapt -->

    <owl:ObjectProperty rdf:about="http://www.hcw.ac.at/nis2iso#adapt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include"/>
            <rdf:Description rdf:about="http://www.hcw.ac.at/nis2iso#implementControlDefinition"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.hcw.ac.at/nis2iso#implementControlDefinition -->

    <owl:ObjectProperty rdf:about="http://www.hcw.ac.at/nis2iso#implementControlDefinition"/>
    


    <!-- http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include -->

    <rdf:Description rdf:about="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#include">
        <rdfs:subPropertyOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#take"/>
        <rdfs:subPropertyOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#takeIntoAccount"/>
    </rdf:Description>
    



PREFIX ext:  <http://www.hcw.ac.at/nis2iso#>
PREFIX nis2: <http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT
    ?organisation
    ?implementation
    ?control
    ?nis2Requirement
    ?coverage
WHERE {
    VALUES ?organisation { ext:ExampleOrg }

    ?organisation nis2:include ?implementation .

    ?implementationClass
        owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first
        ?restriction .

    ?restriction
        owl:onProperty ext:implementControlDefinition ;
        owl:hasValue ?control .

    {
        ?implementation rdf:type/rdfs:subClassOf* ?implementationClass .
    }
    UNION
    {
        ?implementation ext:implementControlDefinition ?control .
        ?control rdf:type/rdfs:subClassOf* ext:ISOControlDefinition .
    }

    OPTIONAL {
        {
            {
                ?implementationClass rdfs:subClassOf+ ?nis2Requirement .
            }
            UNION
            {
                ?implementation rdf:type/rdfs:subClassOf* ?nis2Requirement .
            }

            BIND(
                "Full (class inclusion or membership)"
                AS ?mappingCoverage
            )
        }
        UNION
        {
            {
                ?implementationClass ext:partiallyFulfills ?nis2Requirement .
            }
            UNION
            {
                ?control ext:partiallyFulfills ?nis2Requirement .
            }

            FILTER NOT EXISTS {
                ?implementation rdf:type/rdfs:subClassOf* ?nis2Requirement .
            }

            FILTER NOT EXISTS {
                ?implementationClass rdfs:subClassOf+ ?nis2Requirement .
            }

            BIND("Partial (annotation)" AS ?mappingCoverage)
        }

        FILTER(
            REGEX(
                STR(?nis2Requirement),
                "^http://www[.]unict[.]it/nas-inf/nis2onto/nis2onto[.]owl#"
            )
        )
    }

    BIND(
        COALESCE(
            ?mappingCoverage,
            "No ISO-to-NIS2 control mapping recorded"
        )
        AS ?coverage
    )
}
ORDER BY ?organisation ?control ?nis2Requirement ?coverage
